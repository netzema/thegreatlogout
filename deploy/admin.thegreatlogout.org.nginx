limit_req_zone $binary_remote_addr zone=tgl_admin_login:10m rate=5r/m;
server {
    listen 80;
    listen [::]:80;
    server_name admin.thegreatlogout.org;
    location ^~ /.well-known/acme-challenge/ {
        root /home/deploy/apps/thegreatlogout.org;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.thegreatlogout.org;
    ssl_certificate /etc/letsencrypt/live/admin.thegreatlogout.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.thegreatlogout.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    access_log off;
    error_log /var/log/nginx/thegreatlogout-admin.error.log warn;
    client_max_body_size 64k;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location ~ /\. { return 404; }
    location ~* ^/(?:data|deploy|server|tests|worker|scripts)(?:/|$) { return 404; }
    location = /login {
        limit_req zone=tgl_admin_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8789;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
    location / {
        proxy_pass http://127.0.0.1:8789;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
}
