server {
    listen 80;
    listen [::]:80;
    server_name admin.thegreatlogout.org;
    location ^~ /.well-known/acme-challenge/ {
        root /home/deploy/apps/thegreatlogout.org;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 301 https://$host$request_uri; }
}
