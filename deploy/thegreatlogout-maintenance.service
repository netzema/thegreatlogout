[Unit]
Description=The Great Logout backups and analytics retention
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/apps/thegreatlogout.org
EnvironmentFile=-/home/deploy/apps/thegreatlogout.org/.env.admin
ExecStart=/home/deploy/apps/thegreatlogout.org/.venv/bin/python -m server.maintenance
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/deploy/apps/thegreatlogout.org/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
