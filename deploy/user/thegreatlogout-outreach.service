[Unit]
Description=The Great Logout assistive research and drafts

[Service]
Type=oneshot
WorkingDirectory=/home/deploy/apps/thegreatlogout.org
EnvironmentFile=/home/deploy/apps/thegreatlogout.org/.env.admin
ExecStart=/home/deploy/apps/thegreatlogout.org/.venv/bin/python -m server.outreach
TimeoutStartSec=1200
UMask=0077
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
