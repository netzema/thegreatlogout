DATABASE_PATH="/home/deploy/apps/thegreatlogout.org/data/thegreatlogout.db"
ALLOWED_ORIGINS="https://thegreatlogout.org,https://www.thegreatlogout.org"
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM="outbound"
FROM_EMAIL="hello@thegreatlogout.org"
FROM_NAME="The Great Logout"
REPLY_TO="support@thegreatlogout.org"
PUBLIC_SITE_URL="https://thegreatlogout.org"
API_BASE_URL="https://api.thegreatlogout.org"
MIN_FILL_SECONDS=2
MAX_SEND_ATTEMPTS=8

# Admin-only direct outreach configuration belongs in .env.admin.
# Never load guide settings into another application's runtime.
# OUTREACH_DIRECT_SEND_ENABLED=0
# OUTREACH_SMTP_HOST=smtp.mailbox.org
# OUTREACH_SMTP_PORT=587
# OUTREACH_SMTP_USER=  # defaults to the existing OUTREACH_IMAP_USER if unset
# OUTREACH_SMTP_PASSWORD=  # use an application password with SMTP access
# OUTREACH_FROM=  # must be an authorized identity of that mailbox
# OUTREACH_REPLY_TO=
# OUTREACH_SENT_FOLDER=Sent
